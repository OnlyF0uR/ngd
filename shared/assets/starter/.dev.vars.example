# Copy to .dev.vars for local development (git-ignored). Production: npx wrangler secret put NAME
# Turnstile test secret that always passes; replace with the real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Where lead notifications go (must be a verified destination address in Cloudflare Email Routing)
LEAD_NOTIFY_TO=owner@example.com
LEAD_NOTIFY_FROM=website@example.com
# Optional CRM / automation webhook that receives each lead as JSON
LEAD_WEBHOOK_URL=
