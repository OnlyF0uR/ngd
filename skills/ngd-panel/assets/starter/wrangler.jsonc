/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 * After changing bindings run `npm run cf-typegen` so the Env type matches.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-site",
	// Today's date for a new project: the TanStack template ships an old one.
	"compatibility_date": "2026-11-04",
	// The custom server entry (redirects, headers). The template's "@tanstack/react-start/server-entry" would skip it.
	"main": "./src/server.ts",
	"assets": {
		// Prerendered pages are written as /about.html; serve them at /about and drop trailing slashes.
		"html_handling": "drop-trailing-slash"
	},
	// Public, environment-specific values go in "vars"; secrets via `npx wrangler secret put NAME` (and .dev.vars locally).
	// Site facts (production URL, contact details, Turnstile site key) live in src/lib/site.ts.
	"vars": {},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	// Add only the bindings the project uses, for example:
	// "routes": [{ "pattern": "www.example.com", "custom_domain": true }],
	// "d1_databases": [{ "binding": "DB", "database_name": "site", "database_id": "<id>", "migrations_dir": "migrations" }],
	// "send_email": [{ "name": "EMAIL" }],
	// "ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	// "kv_namespaces": [{ "binding": "CONTENT", "id": "<id>" }],
	// "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "<name>" }],
	// "images": { "binding": "IMAGES" },
	// "cache": { "enabled": true }  // Workers Cache: read architecture.md section 12 first
}
